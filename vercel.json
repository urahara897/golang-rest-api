{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.go",
      "use": "@vercel/go",
      "config": {
        "buildCommand": "go mod tidy && CGO_ENABLED=1 go build -tags 'linux,sqlite_foreign_keys'",
        "installCommand": "apt-get update && apt-get install -y gcc sqlite3 libsqlite3-dev",
        "maxDuration": 10,
        "memory": 1024
      }
    }
  ],
  "routes": [
    {
      "src": "/events(/[0-9]+)?",
      "dest": "/api/events/events.go"
    },
    {
      "src": "/events/[0-9]+/register",
      "dest": "/api/registration/register.go"
    },
    {
      "src": "/users",
      "dest": "/api/auth/auth.go"
    },
    {
      "src": "/users/[0-9]+",
      "dest": "/api/auth/users.go"
    },
    {
      "src": "/(login|signup|admin/login|admin/signup)",
      "dest": "/api/auth/auth.go"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.go"
    }
  ]
}
